@page "/admin/products"
@using WebUI.Services
@using Common.DTOs
@using Blazored.LocalStorage
@inject CatalogService CatalogService
@inject ILocalStorageService LocalStore
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Mağaza Yöneticisi")]

<div class="container-fluid py-4 px-4 pb-5">
    <div class="admin-header">
        <div>
            <h2 class="admin-title"><i class="bi bi-box-seam me-2 text-primary"></i> Ürün Yönetimi</h2>
            <p class="admin-subtitle text-muted">Katalogdaki ürünleri ekleyin, silin veya güncelleyin.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success shadow-sm px-3 rounded-pill fw-bold" @onclick="ExportProducts">
                <i class="bi bi-download me-2"></i>Excel İndir
            </button>
            <label class="btn btn-outline-secondary shadow-sm px-3 rounded-pill fw-bold mb-0" style="cursor:pointer;">
                <i class="bi bi-upload me-2"></i>Excel Yükle
                <InputFile OnChange="ImportProducts" accept=".xlsx" style="display:none;" />
            </label>
            <button class="btn btn-primary shadow-sm px-4 rounded-pill fw-bold" @onclick="ShowAddModal">
                <i class="bi bi-plus-lg me-2"></i>Yeni Ürün Ekle
            </button>
        </div>
    </div>

    <!-- Ürün Listesi Tablosu -->
    <div class="admin-card border-0 p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table w-100 table-hover align-middle mb-0">
                <thead class="text-muted small text-uppercase" >
                    <tr>
                        <th class="px-4 py-3 border-0">Ürün Bilgisi</th>
                        <th class="py-3 border-0">Kategori</th>
                        <th class="py-3 border-0 text-center">Stok</th>
                        <th class="py-3 border-0">Fiyat</th>
                        <th class="py-3 text-end px-4 border-0">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (int i = 0; i < 5; i++)
                        {
                            <tr>
                                <td colspan="5" class="p-0">
                                    <div class="skeleton skeleton-row m-0 w-100" style="border-radius: 0; opacity: 0.5;"></div>
                                </td>
                            </tr>
                        }
                    }
                    else if (products == null || !products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                                Hiç ürün bulunamadı.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in products)
                        {
                            <tr class="border-bottom border">
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-3 bg-light p-1 me-3 d-flex align-items-center justify-content-center overflow-hidden border border" style="width: 52px; height: 52px;">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@CatalogService.GetFullImageUrl(item.ImageUrl)" class="w-100 h-100 object-fit-cover rounded-2" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-box-seam text-primary fs-4"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.Name</div>
                                            <div class="text-muted smaller">ID: @item.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border rounded-pill px-3 py-2">
                                        @item.Category
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.StockQuantity < 10 ? "bg-danger" : "bg-success") bg-opacity-10 @(item.StockQuantity < 10 ? "text-danger" : "text-success") rounded-pill px-3 py-2">
                                        @item.StockQuantity Adet
                                    </span>
                                </td>
                                <td class="fw-bold text-primary">@item.Price.ToString("C")</td>
                                <td class="text-end px-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="btn btn-sm btn-white btn-opacity-10 rounded-pill border-0" 
                                                @onclick="() => ShowEditModal(item)" title="Düzenle">
                                            <i class="bi bi-pencil text-primary"></i>
                                        </button>
                                        <button class="btn btn-sm btn-white btn-opacity-10 rounded-pill border-0" 
                                                @onclick="() => ConfirmDelete(item.Id)" title="Sil">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--Ekleme/Düzenleme Formu  -->
@if (showModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.4); z-index: 1050;">
        <div class="bg-white rounded-4 p-4 overflow-auto shadow" style="width: 520px; max-height: 90vh;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">@(isEditMode ? "Ürünü Düzenle" : "Yeni Ürün Ekle")</h4>
                <button class="btn-close" @onclick="HideModal"></button>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Ürün Adı</label>
                <input @bind="newProduct.Name" class="form-control" placeholder="Örn: Mechanical Keyboard" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Ürün Resmi</label>
                <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background:#F8F8F8; border:1px dashed #ccc;">
                    @if (!string.IsNullOrEmpty(uploadPreview))
                    {
                        <img src="@uploadPreview" class="rounded-3" style="width:72px;height:72px;object-fit:cover;border:1px solid #eee;" />
                    }
                    else
                    {
                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-white" style="width:72px;height:72px;border:1px solid #eee;">
                            <i class="bi bi-image text-muted fs-3"></i>
                        </div>
                    }
                    <div class="flex-grow-1">
                        <InputFile OnChange="HandleFileSelected" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="small text-muted mt-1">PNG, JPG veya WebP (Max 5MB)</div>
                    </div>
                </div>
                @if (isUploading)
                {
                    <div class="progress mt-2" style="height:4px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-dark w-100"></div>
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Ek Resimler (Galeri)</label>
                <div class="p-3 rounded-3" style="background:#F8F8F8; border:1px dashed #ccc;">
                    <InputFile OnChange="HandleAdditionalFiles" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" multiple />
                    <div class="small text-muted mt-1">Birden fazla resim seçebilirsiniz (Max 5 adet)</div>
                    @if (additionalPreviews.Any())
                    {
                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            @foreach (var preview in additionalPreviews)
                            {
                                <img src="@preview" class="rounded-2" style="width:56px;height:56px;object-fit:cover;border:1px solid #eee;" />
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Kategori</label>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var cat in categories)
                    {
                        <span @onclick="() => SetCategory(cat)"
                              class="badge rounded-pill py-2 px-3 @(newProduct.Category == cat ? "bg-dark text-white" : "bg-light text-dark border")"
                              style="cursor:pointer; font-size:0.8rem;">
                            @cat
                        </span>
                    }
                </div>
                <input @bind="newProduct.Category" class="form-control" placeholder="Veya kategori yazın..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Özellikler (her satıra bir tane)</label>
                <textarea @bind="featuresText" class="form-control" rows="3" placeholder="Örn: RGB Aydınlatma&#10;Blue Switch"></textarea>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <label class="form-label fw-semibold small text-muted">Fiyat (₺)</label>
                    <input @bind="newProduct.Price" type="number" class="form-control fw-bold" />
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold small text-muted">Stok Adedi</label>
                    <input @bind="newProduct.StockQuantity" type="number" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary w-100 py-2 fw-semibold" @onclick="HideModal">Vazgeç</button>
                <button class="btn btn-dark w-100 py-2 fw-semibold" @onclick="HandleAddProduct" disabled="@(isProcessing || isUploading)">
                    @if (isProcessing || isUploading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    @(isEditMode ? "Güncelle" : "Ekle")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto>? products;
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private bool isProcessing = false;
    private bool isUploading = false;
    private string? uploadPreview;
    private string? featuresText;
    private IBrowserFile? selectedFile;
    private List<IBrowserFile> additionalFiles = new();
    private List<string> additionalPreviews = new();
    private ProductDto newProduct = new();
    private List<string> categories = new() { "Donanım", "Klavye", "Mouse", "Monitör", "Laptop" };

    private void SetCategory(string cat) => newProduct.Category = cat;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task ExportProducts()
    {
        var token = await LocalStore.GetItemAsync<string>("authToken");
        var bytes = await CatalogService.ExportProducts(token!);
        if (bytes == null) { ToastService.Notify("Excel indirilemedi.", ToastLevel.Error); return; }
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", $"urunler_{DateTime.Now:yyyyMMdd}.xlsx", base64);
    }

    private async Task ImportProducts(InputFileChangeEventArgs e)
    {
        var token = await LocalStore.GetItemAsync<string>("authToken");
        var file = e.File;
        var (imported, errors) = await CatalogService.ImportProducts(token!, file);
        if (imported > 0)
        {
            ToastService.Notify($"{imported} ürün başarıyla içe aktarıldı.", ToastLevel.Success);
            await LoadProducts();
        }
        if (errors.Any())
            ToastService.Notify($"{errors.Count} satırda hata oluştu.", ToastLevel.Warning);
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        try 
        {
            products = await CatalogService.GetProducts();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddModal()
    {
        newProduct = new();
        uploadPreview = null;
        featuresText = "";
        selectedFile = null;
        additionalFiles = new();
        additionalPreviews = new();
        isEditMode = false;
        showModal = true;
    }

    private void ShowEditModal(ProductDto product)
    {
        newProduct = new ProductDto 
        {
            Id = product.Id,
            Name = product.Name,
            Category = product.Category,
            Description = product.Description,
            Price = product.Price,
            StockQuantity = product.StockQuantity,
            ImageUrl = product.ImageUrl,
            Rating = product.Rating,
            ReviewCount = product.ReviewCount,
            Features = new List<string>(product.Features)
        };
        uploadPreview = CatalogService.GetFullImageUrl(product.ImageUrl);
        featuresText = string.Join("\n", product.Features);
        selectedFile = null;
        additionalFiles = new();
        additionalPreviews = new();
        isEditMode = true;
        showModal = true;
    }
    
    private void HideModal() => showModal = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        var format = selectedFile.ContentType;
        var imageFile = await selectedFile.RequestImageFileAsync(format, 400, 400);
        var buffer = new byte[imageFile.Size];
        await imageFile.OpenReadStream().ReadAsync(buffer);
        uploadPreview = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task HandleAdditionalFiles(InputFileChangeEventArgs e)
    {
        additionalFiles = e.GetMultipleFiles(5).ToList();
        additionalPreviews.Clear();
        foreach (var file in additionalFiles)
        {
            var format = file.ContentType;
            var imageFile = await file.RequestImageFileAsync(format, 200, 200);
            var buffer = new byte[imageFile.Size];
            await imageFile.OpenReadStream().ReadAsync(buffer);
            additionalPreviews.Add($"data:{format};base64,{Convert.ToBase64String(buffer)}");
        }
    }

    private async Task HandleAddProduct()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Name)) return;

        isProcessing = true;
        
        var token = await LocalStore.GetItemAsync<string>("authToken");
        
        if(!string.IsNullOrEmpty(token))
        {
            // Özellikleri metin alanından ayıkla
            newProduct.Features = featuresText?.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                                              .Select(x => x.Trim())
                                              .ToList() ?? new();

            bool success;
            var extras = additionalFiles.Any() ? additionalFiles : null;
            if (isEditMode)
            {
                success = await CatalogService.UpdateProduct(token, newProduct, selectedFile, extras);
            }
            else
            {
                success = await CatalogService.CreateProduct(token, newProduct, selectedFile, extras);
            }

            if(success)
            {
                await LoadProducts(); // Listeyi güncelle
                showModal = false;    // Formu kapat
                ToastService.Notify(isEditMode ? "Ürün güncellendi." : "Ürün başarıyla eklendi.", ToastLevel.Success);
            }
            else
            {
                Console.WriteLine($"[ProductManagement] Kaydetme başarısız. Mode: {(isEditMode ? "Edit" : "Add")}");
                ToastService.Notify("Ürün kaydedilemedi. Lütfen tarayıcı konsoluna (F12) bakın.", ToastLevel.Error);
            }
        }
        else
        {
            ToastService.Notify("Oturum süreniz dolmuş olabilir. Lütfen tekrar giriş yapın.", ToastLevel.Warning);
        }
        
        isProcessing = false;
    }

    private async Task ConfirmDelete(string? id)
    {
        if (string.IsNullOrEmpty(id)) return;
        var token = await LocalStore.GetItemAsync<string>("authToken");
        
        if(!string.IsNullOrEmpty(token))
        {
            var result = await CatalogService.DeleteProduct(token, id);
            if(result.Success)
            {
                await LoadProducts();
                ToastService.Notify("Ürün başarıyla silindi.", ToastLevel.Success);
            }
            else
            {
                ToastService.Notify($"Ürün silinemedi! Hata: {result.Message}", ToastLevel.Error);
            }
        }
    }
}
